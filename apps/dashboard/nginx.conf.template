# Phase 16: nginx config for the production dashboard container.
# Serves the built static SPA and proxies /api + /ws to the API.
#
# API_ORIGIN is a template variable, substituted by nginx's own
# built-in docker-entrypoint scripts (envsubst-on-templates, included
# in the nginx:1.27-alpine base image) at container start -- see
# apps/dashboard/Dockerfile for the ENV API_ORIGIN default and the
# NGINX_ENVSUBST_FILTER scoping that protects nginx's own request-time
# variables below ($host, $remote_addr, $scheme, $http_upgrade, $uri,
# $proxy_add_x_forwarded_for, $proxy_host) from being touched by that
# substitution. Defaults to the Docker Compose service name
# (http://api:3000), so infra/docker-compose.prod.yml's existing
# behavior is unchanged unless API_ORIGIN is explicitly overridden --
# e.g. for a deployment where the API has its own public URL instead
# of a shared Docker network (see docs/deployment.md).

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Render-only 502 root cause: with a literal (non-variable)
    # proxy_pass target, nginx resolves the upstream hostname ONCE at
    # startup and caches that IP for the life of the worker process --
    # standard nginx behavior. Render's public *.onrender.com hostnames
    # are served by a shared edge whose backing IP(s) are not
    # guaranteed stable for that long; once the cached IP stops being
    # correct, every request keeps hitting it anyway. Locally this
    # never showed up because API_ORIGIN defaults to the Docker
    # Compose service name "api", resolved by Docker's own embedded DNS
    # (127.0.0.11), which is always live. The fix below (resolver +
    # `set` variable in each location's proxy_pass) makes nginx
    # re-resolve on the `valid` TTL instead of caching forever.
    # DNS_RESOLVER defaults to Docker's embedded resolver so
    # infra/docker-compose.prod.yml's behavior is unchanged; override
    # it to a real DNS server when API_ORIGIN points at a public
    # hostname, same as API_ORIGIN itself is overridden for that
    # deployment.
    resolver ${DNS_RESOLVER} valid=10s;

    # Static assets: long-lived, content-hashed filenames from Vite's
    # build -- safe to cache aggressively.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # SPA fallback: any non-file, non-/api, non-/ws route serves
    # index.html so client-side routing (if added later) keeps working.
    location / {
        try_files $uri /index.html;
    }

    location /api/ {
        # $api_upstream (not a literal here) is what makes nginx consult
        # the `resolver` above instead of resolving once at startup --
        # see the comment on `resolver` for why this matters on Render.
        set $api_upstream ${API_ORIGIN};
        proxy_pass $api_upstream$request_uri;
        # nginx 1.27's default proxy_http_version is 1.0 (the default
        # only became 1.1 in nginx 1.29.7). /ws below already needed to
        # set 1.1 explicitly for the WebSocket Upgrade handshake, but
        # /api/ never got the same treatment -- so every API request was
        # silently being forwarded as HTTP/1.0. Render's public edge is a
        # Host/SNI-based virtual-hosting router in front of this
        # container; that class of infrastructure expects HTTP/1.1 and
        # can refuse or reset an HTTP/1.0 request from a backend client,
        # which surfaces here as a 502. nginx already defaults
        # Connection: close for proxied requests (both 1.0 and 1.1), so
        # no companion header change is needed.
        proxy_http_version 1.1;
        # Real bug, Render deployment: with an HTTPS API_ORIGIN, nginx was
        # sending the incoming dashboard Host and no SNI to the upstream,
        # so Render's hostname/SNI-based routing could not identify the
        # target service -- SSL_do_handshake() failed, 502. $proxy_host
        # (nginx's own variable for proxy_pass's target host:port) is the
        # correct upstream identity for both the Host header and the TLS
        # SNI name; proxy_ssl_server_name must be explicitly "on" for
        # nginx to send SNI at all (off by default).
        proxy_ssl_server_name on;
        proxy_ssl_name $proxy_host;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /ws {
        # Same dynamic-resolution fix as /api/ above -- see the
        # `resolver` and $api_upstream comments there.
        set $api_upstream ${API_ORIGIN};
        proxy_pass $api_upstream$request_uri;
        # Same upstream-identity fix as /api/ above (SNI + Host must match
        # the upstream, not the incoming dashboard host) -- see that
        # location's comment for the full explanation.
        proxy_ssl_server_name on;
        proxy_ssl_name $proxy_host;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $proxy_host;
        proxy_read_timeout 3600s;
    }
}
