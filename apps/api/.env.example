NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://user:password@localhost:5432/dbname
RABBITMQ_URL=amqp://user:password@localhost:5672

# Phase 16: public security baseline. Both REQUIRED when NODE_ENV=production
# (the app refuses to start in production without them -- see config/env.ts).
# Optional in development/test: leaving API_KEY unset makes every route
# unauthenticated (dev/test-only fallback, never allowed in production).
API_KEY=
# Comma-separated list of exact origins allowed to make cross-origin
# requests (e.g. https://dashboard.example.com). Never "*".
CORS_ALLOWED_ORIGINS=

# Optional, defaults to "100kb" if unset.
JSON_BODY_LIMIT=100kb
