# Phase 16: template for infra/docker-compose.prod.yml. Copy to
# infra/.env.production (gitignored) and fill in real values, then run:
#   docker compose -f infra/docker-compose.prod.yml --env-file infra/.env.production up -d --build
#
# Every value below is required -- the compose file uses `:?` required-
# variable syntax for the security-sensitive ones, so `docker compose`
# itself refuses to start with a clear error if any are missing. This
# file is committed only as a template with NO real values.

POSTGRES_USER=deadletter
POSTGRES_PASSWORD=
POSTGRES_DB=deadletter

RABBITMQ_USER=deadletter
RABBITMQ_PASSWORD=

# Shared operator API key required on state-changing routes
# (POST /api/jobs, POST /api/jobs/:id/replay). Generate a real random
# value, e.g.: openssl rand -hex 32
API_KEY=

# Comma-separated list of exact origins allowed to call the API
# cross-origin. If the dashboard container's own nginx proxy is the
# only thing calling the API (the default single-entry-point shape in
# docker-compose.prod.yml), this can be the dashboard's own public
# origin, e.g. https://deadletter.example.com
CORS_ALLOWED_ORIGINS=

# Host port the dashboard container's nginx listens on. Put a real
# HTTPS-terminating reverse proxy/load balancer in front of this in
# any real public deployment -- this container itself serves plain
# HTTP on this port.
DASHBOARD_PUBLIC_PORT=80
